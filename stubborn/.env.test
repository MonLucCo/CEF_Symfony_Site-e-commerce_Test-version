###############################################
# ENVIRONNEMENT DE TEST
# - Isolé de la base de développement
# - Utilise SQLite pour rapidité et sécurité
# - Ne doit JAMAIS toucher aux données réelles
###############################################

APP_ENV=test
APP_DEBUG=1
KERNEL_CLASS='App\Kernel'
APP_SECRET='test_secret_key'

###############################################
# BASE DE DONNÉES DE TEST
# - SQLite : rapide, jetable, portable
# - Fichier stocké dans var/tests/
# - Recréé automatiquement par test:init
###############################################

DATABASE_URL="sqlite:///%kernel.project_dir%/var/tests/data_test.db"

###############################################
# CONFIGURATION APPLICATION
###############################################

APP_DEFAULT_LOCALE=fr

# Aucun mail envoyé en test
MAILER_DSN=null://null

###############################################
# CLÉS STRIPE (FAUSSES)
# - Les tests utilisent des mocks
# - Aucune requête réelle envoyée à Stripe
###############################################

STRIPE_PUBLIC_KEY="test_public"
STRIPE_SECRET_KEY="test_secret"
