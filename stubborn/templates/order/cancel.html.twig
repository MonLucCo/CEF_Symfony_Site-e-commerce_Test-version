{% extends 'base.html.twig' %}

{% block title %}
	{{ 'order.cancel.title'|trans }}
{% endblock %}

{% block body %}

	<section class="order-container">

		<h1>{{ 'order.cancel.title'|trans }}</h1>
		<h2>{{ 'order.cancel.subtitle'|trans }}</h2>

		<p>{{ 'order.cancel.message'|trans }}</p>

		<div class="order-actions">
			<div class="order-action-left">
				<p>
					<a href="{{ path('app_cart_index') }}" class="btn-secondary" data-test="order-btn-cart">{{ 'order.cancel.back_cart'|trans }}</a>
				</p>
				<p>
					<a href="{{ path('app_home') }}" class="btn-secondary" datat-test="order-btn-home">{{ 'order.cancel.back_home'|trans }}</a>
				</p>
			</div>

			<div class="order-actions-rigth">
				<p>
					<a href="{{ path('app_order_checkout') }}" class="btn-primary" data-test="order-btn-checkout">{{ 'order.cancel.retry'|trans }}</a>
				</p>
			</div>
		</div>

	</section>

{% endblock %}
