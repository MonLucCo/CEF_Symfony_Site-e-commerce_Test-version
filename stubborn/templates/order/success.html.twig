{% extends 'base.html.twig' %}

{% block title %}
	{{ 'order.success.title'|trans }}
{% endblock %}

{% block body %}

	<section class="order-container">

		<h1>{{ 'order.success.title'|trans }}</h1>
		<h2>{{ 'order.success.subtitle'|trans }}</h2>

		<p>{{ 'order.success.message'|trans }}</p>

		<div class="order-actions">
			<div class="order-action-left">
				<p>
					<a href="{{ path('app_products') }}" class="btn-secondary" data-test="order-btn-shop">{{ 'order.success.back_shop'|trans }}</a>
				</p>

				<p>
					<a href="{{ path('app_home') }}" class="btn-secondary" data-test="order-btn-home">{{ 'order.success.back_home'|trans }}</a>
				</p>
			</div>

			<div class="order-actions-rigth">
				<p>
			<form action="{{ path('app_order_send_confirmation') }}" method="post">
				<input type="hidden" name="_token" value="{{ csrf_token('order_send_confirmation') }}">
				<button class="btn-primary" data-test="order-btn-email">
					{{ 'order.success.send_email'|trans }}
				</button>
			</form>
			</div>
		</section>

	{% endblock %}
