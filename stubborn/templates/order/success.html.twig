{% extends 'base.html.twig' %}

{% block title %}
	{{ 'order.success.title'|trans }}
{% endblock %}

{% block body %}
	<h1>{{ 'order.success.title'|trans }}</h1>
	<h2>{{ 'order.success.subtitle'|trans }}</h2>

	<p>{{ 'order.success.message'|trans }}</p>

	<p>
		<a href="{{ path('order_send_confirmation') }}" class="btn btn-primary">
			{{ 'order.success.send_email'|trans }}
		</a>
	</p>

	<p>
		<a href="{{ path('app_products') }}">{{ 'order.success.back_shop'|trans }}</a>
	</p>

	<p>
		<a href="{{ path('app_home') }}">{{ 'order.success.back_home'|trans }}</a>
	</p>
{% endblock %}
