{% extends 'base.html.twig' %}

{% block title %}Accueil — Stubborn
{% endblock %}

{% block body %}

	<section class="home-hero">
		<h1>Bienvenue chez Stubborn</h1>
		<p>Don't compromise on your look.</p>
		<p>Découvrez nos sweat-shirts de qualité, conçus pour durer.</p>
	</section>

	<section class="featured-products">
		<h2>Produits mis en avant</h2>

		<div class="featured-grid">
			{% for product in featured %}
				<div class="product-card">
					<img src="{{ asset('images/products/' ~ product.image) }}" alt="{{ product.name }}">

					<h3>{{ product.name }}</h3>
					<p>{{ product.price }}
						€</p>

					{% if app.user %}
						<a class="btn" href="{{ path('app_product_show', {id: product.id}) }}">
							Voir >
						</a>
					{% endif %}
				</div>
			{% endfor %}
		</div>
	</section>

{% endblock %}
