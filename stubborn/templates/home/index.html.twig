{% extends 'base.html.twig' %}

{% block title %}Accueil — Stubborn
{% endblock %}

{% block body %}

	<section class="home-hero">
		<h1>{{ 'home.hero.title'|trans }}</h1>
		<p>{{ 'home.hero.slogan'|trans }}</p>
		<p>{{ 'home.hero.subtitle'|trans }}</p>
	</section>

	<section class="home-about">
		<h2>{{ 'home.about.title'|trans }}</h2>
		<p>{{ 'home.about.text'|trans }}</p>
	</section>

	{% if featured %}
		<section class="featured-products">
			<h2>{{ 'home.featured.title'|trans }}</h2>

			<div class="featured-grid">
				{% for product in featured %}
					<div class="product-card">
						<img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}">

						<h3>{{ product.name }}</h3>
						<p>{{ product.price }}
							€</p>

						{% if app.user %}
							<a class="btn" href="{{ path('app_product_show', {id: product.id}) }}">
								{{ 'home.featured.view'|trans }}
								>
							</a>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		</section>
	{% endif %}

{% endblock %}
