		<h1>{{ 'account.not_verified.title'|trans }}</h1>
		<p>{{ 'account.not_verified.message'|trans }}</p>

		<p>
			<a class="btn-primary" href="{{ path('app_register_resend') }}">
				{{ 'account.not_verified.resend'|trans }}
