{% extends 'base.html.twig' %}

{% block title %}
	{{ product.name }}
{% endblock %}

{% block body %}
	<h1>{{ product.name }}</h1>

	<div class="product-details">
		<img
		src="{{ asset('images/products/' ~ product.image) }}" alt="{{ product.name }}">

		{# Formulaire permettant de sélectionner la taille du sweat-shirt #}
		<form action="{{ path('app_cart_add', { id: product.id }) }}" method="get" class="size-form">
			<label for="size">Taille :</label>
			<select name="size" id="size" required>
				<option value="" disabled selected>-- Choisir une taille --</option>
				{# <option value="S">S</option>
								<option value="M">M</option>
								<option value="L">L</option>
								<option value="XL">XL</option> #}
				{% for size in constant('App\\Entity\\Product::SIZES') %}
					<option value="{{ size }}">{{ size }}</option>
				{% endfor %}
			</select>

			<button type="submit" class="btn">Ajouter au panier</button>
		</form>

		<div class="info">
			<p>
				<strong>Prix :</strong>
				{{ product.price }}
				€</p>

			<p>
				<a href="{{ path('app_products') }}" class="back-link">← Retour à la boutique</a>
			</p>
		</div>
	</div>
{% endblock %}
