{% trans_default_domain 'admin' %}

{% extends 'base_admin.html.twig' %}

{% block title %}{{ 'admin.edit_title'|trans }}{% endblock %}

{% block body %}
<h1>{{ 'admin.edit_title'|trans }}</h1>

{{ form_start(form) }}

    {{ form_row(form.name) }}
    {{ form_row(form.price) }}

    <fieldset class="mt-4 p-3 border rounded">
        <legend class="fw-bold">{{ 'admin.current_image.legend'|trans }}</legend>

        {% if product.image %}
            <img src="{{ asset('uploads/products/' ~ product.image) }}"
                alt="{{ product.name }}"
                style="max-width: 200px; height: auto; border: 1px solid #ccc; padding: 4px;">
        {% else %}
            <p class="text-muted">{{ 'admin.current_image.none'|trans }}</p>
        {% endif %}
    </fieldset>

    <fieldset class="mt-4 p-3 border rounded">
        <legend class="fw-bold">{{ 'admin.new_image.legend'|trans }}</legend>

        {{ form_row(form.imageFile) }}

        <button type="button" id="clear-file" class="btn btn-secondary btn-sm mt-2">
            {{ 'admin.new_image.clear'|trans }}
        </button>

        <div id="preview" class="mt-3" style="display:none;">
            <p class="form-label">{{ 'admin.new_image.preview'|trans }}</p>
            <img id="preview-img"
                style="max-width: 200px; height: auto; border: 1px solid #ccc; padding: 4px;">
        </div>
    </fieldset>

    <fieldset class="mt-4 p-3 border rounded">
        <legend class="fw-bold">{{ 'product.form.stock.legend'|trans({}, 'forms') }}</legend>

        <p class="form-text text-muted">
            {{ 'product.form.stock.help'|trans({}, 'forms') }}
        </p>

        {{ form_row(form.stockXS) }}
        {{ form_row(form.stockS) }}
        {{ form_row(form.stockM) }}
        {{ form_row(form.stockL) }}
        {{ form_row(form.stockXL) }}
    </fieldset>

    <button class="btn btn-primary">{{ 'admin.actions.save'|trans }}</button>

{{ form_end(form) }}

<a href="{{ path('app_admin') }}" class="btn btn-secondary">
    {{ 'admin.actions.back'|trans }}
</a>
{% endblock %}

{% block javascripts_body %}
<script>
document.addEventListener('turbo:load', () => {
    const input = document.querySelector('input[type="file"]');
    const preview = document.getElementById('preview');
    const previewImg = document.getElementById('preview-img');
    const clearBtn = document.getElementById('clear-file');

    if (!input) return;

    // Masquer le bouton au chargement
    clearBtn.style.display = 'none';

    input.addEventListener('change', e => {
        const file = e.target.files[0];

        if (!file) {
            preview.style.display = 'none';
            clearBtn.style.display = 'none';
            return;
        }

        previewImg.src = URL.createObjectURL(file);
        preview.style.display = 'block';
        clearBtn.style.display = 'inline-block';
    });

    clearBtn.addEventListener('click', () => {
        input.value = "";
        preview.style.display = 'none';
        clearBtn.style.display = 'none';
    });
});
</script>
{% endblock %}
