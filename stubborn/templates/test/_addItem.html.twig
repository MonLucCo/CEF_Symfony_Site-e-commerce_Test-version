{# Debug : templates/test/_addItem.html.twig 

Ce formulaire est un outil de test manuel pour simuler l'ajout d'un article au panier.
Il utilise JavaScript pour modifier dynamiquement l'URL d'action du formulaire en fonction des sélections de l'utilisateur.
L'URL d'action par défaut est définie avec des valeurs fictives (id: 0, size: 'X') qui seront remplacées lors de la soumission 
du formulaire. 
#}

<fieldset class="mt-4 border rounded p-3">
	<legend class="w-auto px-2">
		Formulaire de test (manuel) pour ajouter un article au panier
	</legend>

	<form
		action="{{ path('app_cart_add', {id: 0, size: 'X'}) }}" method="post" class="border p-3 rounded" onsubmit="this.action = this.action
											.replace('/0/', '/' + document.getElementById('test_product').value + '/')
											.replace('/X', '/' + document.getElementById('test_size').value);">

		{# Sélection du produit #}
		<div class="mb-3">
			<label for="test_product" class="form-label">Produit</label>
			<select id="test_product" class="form-select" required>
				{% for product in testData.products %}
					<option value="{{ product.id }}">
						{{ product.id }}
						—
						{{ product.name }}
					</option>
				{% endfor %}
			</select>
		</div>

		{# Sélection de la taille #}
		<div class="mb-3">
			<label for="test_size" class="form-label">Taille</label>
			<select id="test_size" class="form-select" required>
				{% for size in testData.sizes %}
					<option value="{{ size }}">{{ size }}</option>
				{% endfor %}
			</select>
		</div>

		{# Sélecteur pour choisir un token valide ou invalide #}
		<div class="mb-3">
			<label for="test_token" class="form-label">Type de token CSRF</label>
			<select id="test_token" class="form-select">
				<option value="valid">Token valide (cart_add)</option>
				<option value="invalid">Token invalide</option>
			</select>
		</div>

		{# Token réellement envoyé #}
		{% set valid_token = csrf_token('app_cart_add') %}
		<input type="hidden" id="csrf_token_field" name="_token" value="{{ valid_token }}">

		<script>
			{# Mise à jour dynamique du token selon le choix #}
document.getElementById('test_token').addEventListener('change', function () {
const field = document.getElementById('csrf_token_field');
field.value = (this.value === 'valid') ? "{{ valid_token }}" : "INVALID_TOKEN_FOR_TEST";
});
		</script>

		<button class="btn btn-primary mt-2">Ajouter (POST)</button>
	</form>
</fieldset>
