{% extends 'base.html.twig' %}

{% block title %}
	{{ 'login.title'|trans }}
{% endblock %}

{% block body %}
	<section class="form-container">
		<h1>{{ 'login.header'|trans }}</h1>

		{% if error %}
			<div class="flash flash-error">
				{{ error.messageKey|trans(error.messageData, 'security') }}
			</div>
		{% endif %}

		{% if app.user %}
			<p>
				{{ 'login.logged_in_as'|trans({'%user%': app.user.userIdentifier}) }},
				<a href="{{ logout_path() }}">{{ 'login.logout'|trans }}</a>
			</p>
		{% endif %}

		<form method="post">
			<section class="form-group">
				<div>
					<label for="username">{{ 'login.email.label'|trans }}</label>
					<input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>
				</div>
				<div>
					<label for="password">{{ 'login.password.label'|trans }}</label>
					<input type="password" name="_password" id="password" autocomplete="current-password" required>
				</div>
				<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

			{# Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
												See https://symfony.com/doc/current/security/remember_me.html #}

				{#
																	<div class="checkbox mb-3">
																		<input type="checkbox" name="_remember_me" id="_remember_me">
																		<label for="_remember_me">Remember me</label>
																	</div>
																#}
			</section>
			<section class="form-actions">
				<button class="btn-primary" type="submit">
					{{ 'login.submit'|trans }}
				</button>
			</section>
		</form>
	</section>
{% endblock %}
