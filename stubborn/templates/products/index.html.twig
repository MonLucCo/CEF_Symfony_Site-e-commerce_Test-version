{% extends 'base.html.twig' %}

{% block title %}Nos produits
{% endblock %}

{% block body %}
	<h1>Nos produits</h1>

	<form method="get" class="filter-form">
		<label for="price">Filtrer par prix :</label>
		<select name="price" id="price" onchange="this.form.submit()">
			<option value="">Tous les prix</option>
			<option value="10-29" {{ filter == '10-29' ? 'selected' }}>10 à 29 €</option>
			<option value="29-35" {{ filter == '29-35' ? 'selected' }}>29 à 35 €</option>
			<option value="35-50" {{ filter == '35-50' ? 'selected' }}>35 à 50 €</option>
		</select>
	</form>

	<div class="products-grid">
		{% if products is empty %}
			<p>Aucun produit ne correspond à ce filtrage.</p>
		{% else %}
			<div class="products-grid">
				{% for product in products %}
					<article class="product-card">
						<img src="{{ asset('images/products/' ~ product.image) }}" alt="{{ product.name }}">
						<h2>{{ product.name }}</h2>
						<p>{{ product.price }}
							€</p>
						<a class="btn" href="{{ path('app_product_show', { id: product.id }) }}">Voir</a>
					</article>
				{% endfor %}
			</div>
		{% endif %}
	</div>
{% endblock %}
